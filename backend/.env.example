# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Prefer a mounted file in production; do not commit service-account JSON.
FIREBASE_CREDENTIALS_FILE=/run/secrets/firebase_credentials.json
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

GIN_MODE=release
PORT=8081
# Set to true only on the authorized contest host after participant consent is documented.
CAPTURE_ENABLED=false
# Comma-separated interface names; leave empty for automatic non-loopback selection.
SNIFF_IFACE=
# Same-origin Docker deployment does not need CORS. Add a development origin when needed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend build-time value. For Docker, keep /api so nginx proxies to the backend.
VITE_API_URL=/api
